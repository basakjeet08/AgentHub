/* Shared component styling using Textual's active semantic theme variables. */

/* Keep Textual's built-in command behavior while presenting it as a launcher. */
CommandPalette {
    align: center middle;
}

CommandPalette > #--container {
    width: 50%;
    min-width: 36;
    max-width: 80;
    height: 14;
    min-height: 10;
    max-height: 70vh;
    margin-top: 0;
}

CommandPalette CommandList {
    height: 10;
    max-height: 50vh;
}

.muted {
    color: $text-muted;
}

Screen {
    background: $background;
    color: $foreground;
}

.card {
    background: $surface;
}
