SessionSidebar {
    width: 20%;
    height: 100%;
    padding: 2 1 0 1;
    background: $surface;
    overflow-y: hidden;
}

SessionSidebar,
.session-list {
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $surface;
}

#sidebar-brand {
    width: 100%;
    height: 3;
    padding-left: 1;
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

#sidebar-tabs {
    width: 100%;
    height: 3;
    padding-top: 1;
    border-bottom: solid $panel;
}

.sidebar-tab {
    width: 1fr;
    height: 2;
    content-align: center middle;
    color: $text-muted;
    text-style: bold;
}

.sidebar-tab:hover {
    color: $foreground;
    background: $panel;
}

.sidebar-tab.selected {
    color: $primary;
    background: $panel;
    border-bottom: solid $primary;
}

#sidebar-session-area {
    width: 100%;
    height: 1fr;
}

.session-list {
    width: 100%;
    height: 1fr;
    background: transparent;
    border: none;
    overflow-y: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.session-list > .option-list--option {
    padding: 0;
}

.session-list > .option-list--option-highlighted {
    padding: 0;
    background: $panel;
    color: $foreground;
    text-style: none;
}

.sidebar-empty-state {
    width: 100%;
    height: 1fr;
    padding: 1;
    color: $text-muted;
    text-align: center;
}

#agent-legend {
    width: 100%;
    height: auto;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1;
    padding: 1 1 0 1;
    border-top: solid $panel;
}

.legend-item {
    height: 1;
    color: $text-muted;
    overflow: hidden;
}

#sidebar-lock-status {
    width: 100%;
    height: 4;
    padding: 1;
    border-top: solid $panel;
    color: $text-muted;
}

#sidebar-mode-indicator {
    width: 1;
    height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

SessionSidebar.-locked #sidebar-mode-indicator {
    color: $success;
}

SessionSidebar.-unlocked #sidebar-mode-indicator {
    color: $warning;
}

#sidebar-mode-label {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#sidebar-mode-action {
    width: auto;
    margin-left: 1;
    color: $secondary;
    text-align: right;
}
