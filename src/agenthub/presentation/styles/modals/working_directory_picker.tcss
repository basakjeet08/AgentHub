WorkingDirectoryPickerModal {
    align: center middle;
    background: $background 70%;
}

#working-directory-picker-dialog {
    width: 74;
    max-width: 90%;
    height: 70%;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: tall $panel;
}

#working-directory-picker-header {
    width: 100%;
    height: 2;
}

#working-directory-picker-title {
    width: 1fr;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#directory-picker-tree {
    width: 100%;
    height: 1fr;
    background: $background;
    border: tall $panel;
}

#directory-picker-tree:focus {
    border: tall $primary;
}

#working-directory-picker-selected-row {
    width: 100%;
    height: 1;
    margin-top: 1;
}

#working-directory-picker-selected-label {
    width: 10;
    color: $text-muted;
}

#working-directory-picker-selected-path {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#working-directory-picker-filter-row {
    width: 100%;
    height: 1;
}

#working-directory-picker-filter-label {
    width: 10;
    color: $text-muted;
}

#working-directory-picker-filter-value {
    width: 1fr;
    color: $text-muted;
}

#working-directory-picker-filter-value.active-filter {
    color: $secondary;
    text-style: bold;
}

#working-directory-picker-help {
    width: 100%;
    height: 7;
}
