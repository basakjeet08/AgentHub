HarnessPickerModal {
    align: center middle;
    background: $background 70%;
}

#harness-picker-dialog {
    width: 54;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: tall $panel;
}

#harness-picker-header {
    width: 100%;
    height: 2;
}

#harness-picker-title {
    width: 1fr;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#harness-picker-list {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 12;
    background: transparent;
    border: none;
}

#harness-picker-list > .option-list--option {
    padding: 0 1;
}

#harness-picker-list > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

#harness-picker-help {
    width: 100%;
    height: 2;
    margin-top: 1;
}
