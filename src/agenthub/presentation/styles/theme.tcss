/* Shared component styling using Textual's active semantic theme variables. */

Screen {
    background: $background;
    color: $foreground;
}

.muted {
    color: $text-muted;
}

.section-title {
    color: $foreground;
    text-style: bold;
}

.modal-shortcut-grid {
    width: 100%;
    height: auto;
    grid-size: 2;
    grid-columns: 16 1fr;
    grid-rows: 1;
    grid-gutter: 0 2;
}

.modal-shortcut-key {
    color: $secondary;
    text-style: bold;
}

.modal-shortcut-description {
    color: $foreground;
}

.modal-cancel {
    width: 10;
    height: 1;
}

.modal-cancel-key {
    width: 3;
    height: 1;
}

.modal-cancel-description {
    width: 6;
    height: 1;
    margin-left: 1;
}

.card {
    background: $surface;
}

Button {
    min-width: 16;
    height: 3;
    background: $surface;
    color: $foreground;
    border: tall $panel;
    text-style: bold;
}

Button:hover {
    background: $panel;
    border: tall $secondary;
}

Button:focus {
    background: $panel;
    color: $foreground;
    border: tall $primary;
}

Button.primary {
    background: $primary;
    color: $background;
    border: tall $primary;
}

Button.primary:hover,
Button.primary:focus {
    background: $primary-lighten-1;
    color: $background;
    border: tall $secondary;
}

/* Keep Textual's built-in command behavior while presenting it as a launcher. */
CommandPalette {
    align: center middle;
}

CommandPalette > #--container {
    width: 50%;
    min-width: 36;
    max-width: 80;
    height: 14;
    min-height: 10;
    max-height: 70vh;
    margin-top: 0;
}

CommandPalette CommandList {
    height: 10;
    max-height: 50vh;
}
