AgentHubStatusBar {
    width: 100%;
    height: 3;
    padding: 1 2;
    background: $surface;
    color: $text-muted;
    layout: horizontal;
}

#mode-indicator {
    width: 1;
    height: 1;
    margin-right: 1;
    content-align: center middle;
    text-align: center;
}

AgentHubStatusBar.-locked #mode-indicator {
    color: $success;
}

AgentHubStatusBar.-unlocked #mode-indicator {
    color: $warning;
}

#mode-label {
    width: auto;
    min-width: 9;
    color: $foreground;
    text-style: bold;
}

#session-count,
#agent-count {
    width: auto;
    min-width: 13;
    margin-right: 2;
    color: $text-muted;
}

#mode-action {
    width: 1fr;
    min-width: 14;
    margin-left: 1;
    color: $secondary;
    text-align: left;
}
