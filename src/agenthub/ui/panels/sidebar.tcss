SessionSidebar {
    width: 20%;
    height: 100%;
    padding: 2 1 0 1;
    background: $surface;
    overflow-y: auto;
}

SessionSidebar,
.session-list {
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $surface;
}

#sidebar-brand {
    width: 100%;
    height: 3;
    padding-left: 1;
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

.sidebar-section {
    width: 100%;
    padding-bottom: 1;
    border-bottom: solid $panel;
}

#agent-section {
    height: 7fr;
}

#shell-section {
    height: 3fr;
    padding-bottom: 0;
    border-bottom: none;
}

.sidebar-section-header {
    width: 100%;
    height: 2;
}

.sidebar-section-title {
    width: 1fr;
    height: 2;
    padding-left: 1;
    color: $text-muted;
}

.sidebar-section-shortcut {
    width: auto;
    height: 2;
    margin-right: 1;
    color: $secondary;
}

.session-list {
    width: 100%;
    height: 1fr;
    background: transparent;
    border: none;
    overflow-y: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.session-list > .option-list--option {
    padding: 0;
}

.session-list > .option-list--option-highlighted {
    padding: 0;
    background: $panel;
    color: $foreground;
    text-style: none;
}

#agent-session-list > .option-list--option-disabled {
    padding: 0;
    color: $secondary;
    text-style: bold;
}

#agent-legend {
    width: 100%;
    height: auto;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1;
    padding: 1 1 0 1;
    border-top: solid $panel;
}

.legend-item {
    height: 1;
    color: $text-muted;
    overflow: hidden;
}
