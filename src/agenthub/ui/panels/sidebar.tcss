SessionSidebar {
    width: 20%;
    height: 100%;
    padding: 2 1;
    background: $surface;
}

#sidebar-brand {
    width: 100%;
    height: 3;
    padding-left: 1;
    color: $foreground;
    text-style: bold;
}

#sidebar-new-session {
    width: 100%;
    min-width: 0;
    margin-bottom: 2;
    padding: 0;
    background: transparent;
    color: $primary;
    border: tall transparent;
    text-align: left;
    content-align: left middle;
}

#sidebar-new-session:hover,
#sidebar-new-session:focus {
    background: $panel;
    color: $foreground;
    border: tall $primary;
}

#sidebar-section-title {
    width: 100%;
    height: 2;
    padding-left: 1;
    color: $text-muted;
}

#session-list {
    width: 100%;
    height: 1fr;
    background: transparent;
    border: none;
}

#session-list > .option-list--option {
    padding: 0 1;
}

#session-list > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
    text-style: bold;
}
