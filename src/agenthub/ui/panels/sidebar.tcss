SessionSidebar {
    width: 20%;
    height: 100%;
    padding: 2 1 0 1;
    background: $surface;
    overflow-y: auto;
}

#sidebar-brand {
    width: 100%;
    height: 3;
    padding-left: 1;
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

.sidebar-section {
    width: 100%;
    height: 1fr;
    padding-bottom: 1;
    border-bottom: solid $panel;
}

#shell-section {
    padding-bottom: 0;
    border-bottom: none;
}

.sidebar-section-header {
    width: 100%;
    height: 2;
}

.sidebar-section-title {
    width: 1fr;
    height: 2;
    padding-left: 1;
    color: $text-muted;
}

.sidebar-section-shortcut {
    width: auto;
    height: 2;
    margin-right: 1;
    color: $secondary;
}

.session-list {
    width: 100%;
    height: 1fr;
    background: transparent;
    border: none;
    overflow-y: auto;
}

.session-list > .option-list--option {
    padding: 0 1;
}

.session-list > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
    text-style: bold;
}
