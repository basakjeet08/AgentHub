HomeScreen {
    width: 1fr;
    height: 1fr;
    background: $background;
    align: center middle;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $background;
}

#home-content {
    width: 90%;
    max-width: 64;
    min-width: 28;
    height: auto;
    min-height: 24;
    margin: 1 0;
    padding: 0 2;
    align-horizontal: center;
}

#home-heading {
    width: 100%;
    height: 1;
    align-horizontal: center;
}

#home-title {
    width: auto;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#home-tagline {
    width: auto;
    height: 1;
    margin-left: 2;
}

#home-orientation {
    width: 100%;
    height: auto;
    margin: 2 0;
    color: $foreground;
    text-align: center;
    text-wrap: wrap;
}

#home-quick-reference {
    width: 100%;
    max-width: 58;
    height: auto;
    padding: 1 3;
}

.home-reference-title {
    width: 100%;
    height: 1;
    color: $primary;
    text-style: bold;
}

.home-reference-group {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

.home-shortcut-grid {
    width: 100%;
    height: auto;
    margin-top: 1;
    grid-size: 2;
    grid-columns: 16 1fr;
    grid-rows: auto;
    grid-gutter: 0 2;
}

.home-shortcut-key,
.home-shortcut-description {
    height: auto;
    text-wrap: wrap;
}

.home-shortcut-key {
    color: $secondary;
    text-style: bold;
}

.home-shortcut-description {
    color: $foreground;
}

#home-readme-hint {
    width: 100%;
    height: auto;
    margin-top: 2;
    text-align: center;
    text-wrap: wrap;
}
