HomeScreen {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    background: $background;
    align: center middle;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $background;
}

#home-content {
    width: 88%;
    max-width: 100;
    min-width: 30;
    height: auto;
    margin: 1 0;
    padding: 0;
    align-horizontal: center;
}

#home-heading {
    width: 100%;
    height: 1;
    align-horizontal: center;
}

#home-title {
    width: auto;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#home-tagline {
    width: auto;
    height: 1;
    margin-left: 2;
}

#home-tabs {
    width: 100%;
    height: auto;
}

#home-tabs > ContentTabs {
    width: 100%;
    height: 3;
    padding-top: 1;
    background: transparent;
    border-bottom: solid $panel;
}

#home-tabs ContentTab {
    width: 1fr;
    color: $text-muted;
}

#home-tabs ContentTab.-active {
    color: $primary;
    background: $panel;
    text-style: bold;
}

#home-tabs TabPane {
    width: 100%;
    height: auto;
    padding-top: 1;
}

.home-card {
    width: 100%;
    height: auto;
    padding: 1 2;
}

.home-card-title {
    width: 100%;
    height: 1;
    color: $primary;
    text-style: bold;
}

.home-card-section {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.home-card-subheading {
    width: 100%;
    height: auto;
    color: $foreground;
    text-style: bold;
}

.home-card-copy,
.home-card-note,
.home-flow,
.home-pair-key,
.home-pair-description {
    height: auto;
    text-wrap: wrap;
}

.home-card-copy {
    width: 1fr;
    margin: 1 0 0 2;
    color: $foreground;
}

.home-pair-grid {
    width: 1fr;
    height: auto;
    margin: 1 0 0 2;
    grid-size: 2;
    grid-columns: 13 1fr;
    grid-rows: auto;
}

.home-pair-key {
    width: 100%;
    color: $secondary;
    text-style: bold;
}

.home-pair-description {
    width: 100%;
    color: $foreground;
}

.home-flow {
    width: 100%;
    color: $secondary;
}

.home-indented {
    width: 1fr;
    margin: 1 0 0 2;
}

.home-card-note {
    width: 1fr;
    margin: 1 0 0 2;
    color: $text-muted;
}

.home-management-note {
    margin-top: 2;
}

#home-quick-reference {
    width: 100%;
    height: auto;
    margin-top: 2;
    text-align: center;
    text-wrap: wrap;
}

HomeScreen.narrow #home-content {
    width: 92%;
}

HomeScreen.narrow #home-heading {
    layout: vertical;
    height: 2;
}

HomeScreen.narrow #home-tagline {
    margin-left: 0;
}

HomeScreen.narrow .home-pair-grid {
    grid-columns: 11 1fr;
}
