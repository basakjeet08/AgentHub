WorkingDirectoryModal {
    align: center middle;
    background: $background 70%;
}

#working-directory-dialog {
    width: 74;
    max-width: 90%;
    height: 70%;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: tall $panel;
}

#working-directory-header {
    width: 100%;
    height: 2;
}

#working-directory-title {
    width: 1fr;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#working-directory-tree {
    width: 100%;
    height: 1fr;
    background: $background;
    border: tall $panel;
}

#working-directory-tree:focus {
    border: tall $primary;
}

#working-directory-selected-row {
    width: 100%;
    height: 1;
    margin-top: 1;
}

#working-directory-selected-label {
    width: 10;
    color: $text-muted;
}

#working-directory-selected-path {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#working-directory-help {
    width: 100%;
    height: 5;
    margin-top: 1;
}
